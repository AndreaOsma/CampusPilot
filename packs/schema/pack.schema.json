    "start_time": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Start Time"
    },
    "end_time": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "End Time"
    },
    "url": {
     "default": "",
     "maxLength": 500,
     "title": "Url",
     "type": "string"
    },
    "notes": {
     "default": "",
     "maxLength": 2000,
     "title": "Notes",
     "type": "string"
    }
   },
   "required": [
    "ref",
    "title",
    "date"
   ],
   "title": "PackEvent",
   "type": "object"
  },
  "PackGroup": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Ref",
     "type": "string"
    },
    "name": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "weight": {
     "maximum": 100,
     "minimum": 0,
     "title": "Weight",
     "type": "number"
    },
    "min_grade": {
     "anyOf": [
      {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Min Grade"
    },
    "role": {
     "anyOf": [
      {
       "enum": [
        "ec",
        "pf"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Role"
    }
   },
   "required": [
    "ref",
    "name",
    "weight"
   ],
   "title": "PackGroup",
   "type": "object"
  },
  "PackHabit": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Ref",
     "type": "string"
    },
    "subject": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Subject"
    },
    "title": {
     "maxLength": 200,
