  "PackSubject": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Ref",
     "type": "string"
    },
    "code": {
     "default": "",
     "maxLength": 32,
     "title": "Code",
     "type": "string"
    },
    "name": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "ects": {
     "exclusiveMinimum": 0,
     "maximum": 60,
     "title": "Ects",
     "type": "number"
    },
    "kind": {
     "default": "obligatoria",
     "enum": [
      "basica",
      "obligatoria",
      "optativa",
      "mencion",
      "practicas",
      "tfg",
      "otra"
     ],
     "title": "Kind",
     "type": "string"
    },
    "plan_semester": {
     "anyOf": [
      {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Plan Semester"
    },
    "offered": {
     "anyOf": [
      {
       "enum": [
        "both",
        "s1",
        "s2",
        "t1",
        "t2",
        "t3",
        "q1",
        "q2",
        "q3",
        "q4"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Offered"
    },
    "track": {
     "anyOf": [
      {
       "maxLength": 64,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Track"
    },
    "ai_policy": {
     "default": "unknown",
     "enum": [
      "unknown",
      "allowed",
      "limited",
      "forbidden"
     ],
     "title": "Ai Policy",
     "type": "string"
    },
    "ai_policy_note": {
     "default": "",
     "maxLength": 2000,
     "title": "Ai Policy Note",
     "type": "string"
    },
    "eval_model": {
     "default": "weighted",
     "enum": [
      "weighted",
      "ec_pf"
     ],
     "title": "Eval Model",
     "type": "string"
    },
    "eval_config": {
     "$ref": "#/$defs/EvalConfig"
    },
    "groups": {
     "items": {
      "$ref": "#/$defs/PackGroup"
     },
     "maxItems": 20,
     "title": "Groups",
     "type": "array"
    },
    "links": {
     "items": {
      "$ref": "#/$defs/LinkItem"
     },
     "maxItems": 20,
     "title": "Links",
     "type": "array"
    }
   },
   "required": [
    "ref",
    "name",
    "ects"
   ],
   "title": "PackSubject",
   "type": "object"
  },
  "PackTerm": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
