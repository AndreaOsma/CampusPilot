{
 "$defs": {
  "CareerConfig": {
   "properties": {
    "grade_max": {
     "default": 10,
     "exclusiveMinimum": 0,
     "maximum": 100,
     "title": "Grade Max",
     "type": "number"
    },
    "pass_mark": {
     "default": 5,
     "maximum": 100,
     "minimum": 0,
     "title": "Pass Mark",
     "type": "number"
    },
    "decimals": {
     "default": 2,
     "maximum": 3,
     "minimum": 0,
     "title": "Decimals",
     "type": "integer"
    },
    "credit_label": {
     "default": "ECTS",
     "maxLength": 20,
     "minLength": 1,
     "title": "Credit Label",
     "type": "string"
    },
    "term_system": {
     "default": "semesters",
     "enum": [
      "semesters",
      "trimesters",
      "quarters",
      "annual"
     ],
     "title": "Term System",
     "type": "string"
    },
    "year_start_month": {
     "default": 9,
     "maximum": 12,
     "minimum": 1,
     "title": "Year Start Month",
     "type": "integer"
    },
    "labels": {
     "$ref": "#/$defs/CareerLabels"
    },
    "letters": {
     "items": {
      "$ref": "#/$defs/GradeLetter"
     },
     "maxItems": 15,
     "title": "Letters",
     "type": "array"
    }
   },
   "title": "CareerConfig",
   "type": "object"
  },
  "CareerLabels": {
   "description": "Cómo llama tu universidad a cada cosa (vacío = nombre genérico).",
   "properties": {
    "subject_kinds": {
     "additionalProperties": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     "propertyNames": {
      "enum": [
       "basica",
       "obligatoria",
       "optativa",
       "mencion",
       "practicas",
       "tfg",
       "otra"
      ]
     },
     "title": "Subject Kinds",
     "type": "object"
    },
    "activity_kinds": {
     "additionalProperties": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     "propertyNames": {
      "enum": [
       "pec",
       "pr",
       "quiz",
       "video",
       "exam",
       "lab",
       "project",
       "other"
      ]
     },
     "title": "Activity Kinds",
     "type": "object"
    },
    "ec": {
     "default": "",
     "maxLength": 40,
     "title": "Ec",
     "type": "string"
    },
    "pf": {
     "default": "",
     "maxLength": 40,
     "title": "Pf",
     "type": "string"
    }
   },
   "title": "CareerLabels",
   "type": "object"
  },
  "EvalConfig": {
   "properties": {
    "ec_pass": {
     "default": 5,
     "maximum": 100,
     "minimum": 0,
     "title": "Ec Pass",
     "type": "number"
    },
    "pf_min": {
     "default": 4,
     "maximum": 100,
     "minimum": 0,
     "title": "Pf Min",
     "type": "number"
    },
    "no_show_grade": {
     "default": 3,
     "maximum": 100,
     "minimum": 0,
     "title": "No Show Grade",
     "type": "number"
    }
   },
   "title": "EvalConfig",
   "type": "object"
  },
  "GradeLetter": {
   "description": "Una letra de la escala (A, B, C+…, o SB/NT/AP/SS): desde `min` (incluido); al\napuntar la nota con la letra se guarda `value`.",
   "properties": {
    "label": {
     "maxLength": 12,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "min": {
     "maximum": 100,
     "minimum": 0,
     "title": "Min",
     "type": "number"
    },
    "value": {
     "maximum": 100,
     "minimum": 0,
     "title": "Value",
     "type": "number"
    }
   },
   "required": [
    "label",
    "min",
    "value"
   ],
   "title": "GradeLetter",
   "type": "object"
  },
  "LinkItem": {
   "properties": {
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "url": {
     "maxLength": 500,
     "minLength": 1,
     "title": "Url",
     "type": "string"
    }
   },
   "required": [
    "label",
    "url"
   ],
   "title": "LinkItem",
   "type": "object"
  },
  "PackActivity": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Ref",
     "type": "string"
    },
    "subject": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Subject",
     "type": "string"
    },
    "group": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Group"
    },
    "name": {
     "maxLength": 160,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "kind": {
     "default": "other",
     "enum": [
      "pec",
      "pr",
      "quiz",
      "video",
      "exam",
      "lab",
      "project",
      "other"
     ],
     "title": "Kind",
     "type": "string"
    },
    "weight": {
     "default": 1,
     "maximum": 100,
     "minimum": 0,
     "title": "Weight",
     "type": "number"
    },
    "due_date": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Due Date"
    },
    "due_time": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Due Time"
    },
    "window_start": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Window Start"
    },
    "window_end": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Window End"
    },
    "evaluable": {
     "default": true,
     "title": "Evaluable",
     "type": "boolean"
    },
    "estimated_hours": {
     "anyOf": [
      {
       "maximum": 500,
       "minimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Estimated Hours"
    },
    "notes": {
     "default": "",
     "maxLength": 2000,
     "title": "Notes",
     "type": "string"
    }
   },
   "required": [
    "ref",
    "subject",
    "name"
   ],
   "title": "PackActivity",
   "type": "object"
  },
  "PackEvent": {
   "properties": {
    "ref": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "title": "Ref",
     "type": "string"
    },
    "subject": {
     "anyOf": [
      {
       "type": "string"
