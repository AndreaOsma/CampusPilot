CAMPUS_HTTP_PORT=8080
# 127.0.0.1 = solo este equipo. 0.0.0.0 solo con un proxy con login o una VPN delante.
CAMPUS_BIND=127.0.0.1
CAMPUS_TZ=Europe/Madrid
# Avisos (opcional)
CAMPUS_NTFY_URL=
CAMPUS_NTFY_TOKEN=
CAMPUS_PUBLIC_URL=
# Feed iCal sin login (opcional): una cadena larga y aleatoria, p. ej. `openssl rand -hex 24`
CAMPUS_ICAL_TOKEN=
# IA: se configura en la app (Ajustes → Inteligencia artificial). Opcional: clave Fernet propia
# para cifrar la clave guardada (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
CAMPUS_SECRET_KEY=
# Bandeja de la universidad (opcional): URL del Worker de inbox-worker/ y su token
CAMPUS_INBOX_PULL_URL=
CAMPUS_INBOX_PULL_TOKEN=
